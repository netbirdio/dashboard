# --- Required ---
# Same values as the dashboard's authAuthority / authAudience.
AUTH_AUTHORITY=https://your-idp.example.com
AUTH_AUDIENCE=https://api.netbird.io

ANTHROPIC_API_KEY=sk-ant-...

DATABASE_URL=postgres://user:pass@localhost:5432/netbird_assistant

# --- Server ---
# PORT=8787
# NODE_ENV=development
# ALLOWED_ORIGINS=http://localhost:3000

# --- Models ---
# LLM_MAIN_MODEL=claude-sonnet-5
# LLM_FAST_MODEL=claude-haiku-4-5
# LLM_EFFORT_MAIN=medium

# --- Abuse / cost controls ---
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_SEC=60
# TRUST_PROXY_HEADER=false
# LIMIT_USER_DAILY_TOKENS=1000000
# LIMIT_USER_MONTHLY_TOKENS=10000000
# LIMIT_ACCOUNT_DAILY_TOKENS=10000000
# LIMIT_ACCOUNT_MONTHLY_TOKENS=100000000
# GUARDRAIL_INPUT_CLASSIFIER=false
# SUGGESTIONS_ENABLED=true

# --- PII backstop (Presidio analyzer sidecar; always on, fails open) ---
# PRESIDIO_URL=http://localhost:5002
# PRESIDIO_ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,IP_ADDRESS,CREDIT_CARD,IBAN_CODE,US_SSN,CRYPTO
# PRESIDIO_SCORE_THRESHOLD=0.6
# PRESIDIO_TIMEOUT_MS=2000

# --- Metrics ---
# METRICS_ENABLED=true
# METRICS_PORT=9464
# METRICS_HOST=0.0.0.0
# METRICS_AUTH_TOKEN=change-me
# METRICS_PUSH_URL=https://prometheus.example.com/api/prom/push
# METRICS_PUSH_USER=metrics-user
# METRICS_PUSH_PASSWORD=glc_...
# SERVICE_VERSION=dev
# DEPLOY_ENV=prod
# DEPLOY_HOST=assistant-1

# --- docker-compose.prod.yml only ---
# ASSISTANT_IMAGE=ghcr.io/netbirdio/netbird-assistant:latest
# POSTGRES_PASSWORD=change-me
