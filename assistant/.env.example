# --- Required ---
# Same values as the dashboard's authAuthority / authAudience.
AUTH_AUTHORITY=https://your-idp.example.com
AUTH_AUDIENCE=https://api.netbird.io

ANTHROPIC_API_KEY=sk-ant-...

# --- Server ---
# PORT=8787
# NODE_ENV=development
# ALLOWED_ORIGINS=http://localhost:3000

# --- Models ---
# LLM_MAIN_MODEL=claude-sonnet-5
# LLM_FAST_MODEL=claude-haiku-4-5
# LLM_EFFORT_MAIN=medium

# --- Abuse / cost controls ---
# GUARDRAIL_INPUT_CLASSIFIER=false
# SUGGESTIONS_ENABLED=true
#
# Token buckets, per authenticated user for /v1/* and per client IP for
# /readyz. In-memory, so the limit is PER CONTAINER: N replicas admit up to N
# times these rates. The burst is what a single question can spend at once —
# each client tool call the dashboard fulfils comes back as another request.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CHAT_PER_MINUTE=30
# RATE_LIMIT_CHAT_BURST=15
# RATE_LIMIT_READYZ_PER_MINUTE=60
# RATE_LIMIT_READYZ_BURST=30
#
# Only turn this on when a proxy you control sets X-Forwarded-For: on a
# directly exposed port the header is caller-supplied, and trusting it lets one
# client take an unlimited number of /readyz buckets.
# TRUST_PROXY=false

# --- PII backstop (Presidio analyzer sidecar; always on, fails open) ---
# PRESIDIO_URL=http://localhost:5002
# PRESIDIO_ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,IP_ADDRESS,CREDIT_CARD,IBAN_CODE,US_SSN,CRYPTO
# PRESIDIO_SCORE_THRESHOLD=0.6
# PRESIDIO_TIMEOUT_MS=2000

# --- docker-compose.prod.yml only ---
# ASSISTANT_IMAGE=ghcr.io/netbirdio/netbird-assistant:latest
# PRESIDIO_IMAGE=ghcr.io/data-privacy-stack/presidio-analyzer:2.2.364
