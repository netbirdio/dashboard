# ══════════════════════════════════════════════════════════════════════════
# REQUIRED
# ══════════════════════════════════════════════════════════════════════════

# Auth — either OIDC discovery (preferred), OR both AUTH_ISSUER and AUTH_JWKS_URI.
OIDC_CONFIG_ENDPOINT=https://your-idp/.well-known/openid-configuration
# AUTH_ISSUER=https://your-idp/
# AUTH_JWKS_URI=https://your-idp/.well-known/jwks.json
AUTH_AUDIENCE=https://api.netbird.io

# Provider API key — server-only, never exposed to the browser. Required for
# whichever provider backs a tier (Anthropic by default).
ANTHROPIC_API_KEY=sk-ant-...

# Postgres (telemetry + usage limits).
DATABASE_URL=postgres://user:pass@localhost:5432/netbird_assistant

# ══════════════════════════════════════════════════════════════════════════
# OPTIONAL — defaults shown; uncomment only to override
# ══════════════════════════════════════════════════════════════════════════

# PORT=8787
# NODE_ENV=development
# ALLOWED_ORIGINS=http://localhost:3000        # comma-separated CORS origins

# Seconds a connection may idle before Bun closes it. Must be 1-255 (Bun's cap).
# Bun's own default is 10s, which cuts SSE chat streams whose first event is slow.
# SERVER_IDLE_TIMEOUT_SEC=240

# Models (main tier = chat, fast tier = the guardrail classifier).
# LLM_MAIN_MODEL=claude-sonnet-5               # near-Opus on agentic work, ~40% cheaper
# LLM_FAST_MODEL=claude-haiku-4-5               # guardrail classifier + suggestions
# LLM_MAX_TOKENS=16000                          # thinking and the answer share this
# LLM_EFFORT_MAIN=medium                       # low | medium | high | xhigh | max
# LLM_THINKING=adaptive                        # adaptive | off — "off" costs tool use
# LLM_THINKING_DISPLAY=summarized              # summarized | omitted — the dashboard's status line
#                                              # ("Checking which peers route that network") is condensed
#                                              # from this; "omitted" leaves it stuck on "Working".
# Models the dashboard's picker offers (CSV). The main model is always included.
# Haiku is ~5x cheaper than Opus per token but has a 200K context (vs 1M) and is
# the weakest at the multi-step canvas work, so offer it rather than defaulting to
# it. Effort is dropped automatically for models that reject it (see llm/models.ts).
# LLM_SELECTABLE_MODELS=claude-opus-4-8,claude-sonnet-5,claude-haiku-4-5

# AUTH_USER_ID_CLAIM=sub

# Usage limits (tokens) — reject (402) before the model call once a ceiling is hit.
# LIMIT_USER_DAILY_TOKENS=1000000
# LIMIT_USER_MONTHLY_TOKENS=10000000
# LIMIT_ACCOUNT_DAILY_TOKENS=10000000
# LIMIT_ACCOUNT_MONTHLY_TOKENS=100000000

# Rate limiting (burst control, per account+user).
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_SEC=60

# Burst control for the unauthenticated /readyz probe, per client IP. Loose on
# purpose: a load balancer polls every few seconds and must not be refused.
# PROBE_RATE_LIMIT_MAX=100
# PROBE_RATE_LIMIT_WINDOW_SEC=10
# Read the client IP from X-Forwarded-For. Enable ONLY behind a proxy that
# rewrites the header — otherwise callers can forge it to dodge the limit.
# TRUST_PROXY_HEADER=false

# Guardrails.
# MAX_REQUEST_BYTES=262144                     # 256 KiB request-body ceiling
# MAX_MESSAGES=100
# GUARDRAIL_INPUT_CLASSIFIER=false             # fast-model injection/abuse pre-check

# Metrics (Prometheus /metrics).
# Served on their own port by a second listener, so /metrics is never on the public
# API port. Keep METRICS_PORT unpublished and only the scraper can reach it.
# METRICS_ENABLED=true
# METRICS_PORT=9464
# METRICS_HOST=0.0.0.0                         # 127.0.0.1 on bare metal (in Docker the
#                                              #   scraper is another container)
# SERVICE_VERSION=dev
# METRICS_AUTH_TOKEN=change-me                 # only needed if you expose METRICS_PORT
# How long the Postgres-backed rollup gauges (assistant_tokens_today, active users,
# …) may be reused between scrapes. 0 disables them (no DB query on scrape).
# METRICS_DB_ROLLUP_SEC=30

# ══════════════════════════════════════════════════════════════════════════
# PROD DEPLOY (docker-compose.prod.yml) — required for the prod compose
# ══════════════════════════════════════════════════════════════════════════
# ASSISTANT_IMAGE=ghcr.io/netbirdio/netbird-assistant:latest   # prebuilt image to run
# POSTGRES_PASSWORD=change-me

# Grafana Cloud remote_write (the metrics-agent ships app + host metrics here).
# From Grafana Cloud → Prometheus → "Sending metrics": URL, username, and an API token.
# GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-24-prod-eu-west-2.grafana.net/api/prom/push
# GRAFANA_CLOUD_USER=1616471
# GRAFANA_CLOUD_API_KEY=glc_...
# DEPLOY_ENV=prod                              # label on all metrics (stage|prod)
# DEPLOY_HOST=assistant-1                      # per-box label (optional)
