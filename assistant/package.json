{
  "name": "netbird-assistant",
  "version": "0.1.0",
  "description": "Standalone AI assistant server for NetBird — validates JWTs, drives Anthropic models, returns tool calls to the caller.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "migrate": "bun src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "jose": "^6.1.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.3"
  }
}
