{
  "name": "netbird-dashboard",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "copy": "copyfiles -f ./node_modules/@axa-fr/react-oidc/dist/OidcServiceWorker.js ./public",
    "copytrusted": "copyfiles -f ./public/local/OidcTrustedDomains.js ./public",
    "dev": "next dev -p 3000",
    "build": "next build",
    "postbuild": "node postbuild.js",
    "start": "next start",
    "lint": "eslint .",
    "test:setup": "cd ./e2e/environment && sh create-test-env.sh",
    "test:clean": "cd ./e2e/environment && sh clean-test-env.sh",
    "test:dev": "cross-env APP_ENV=test next dev -p 1337",
    "test": "npx playwright test --config=e2e/playwright.config.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ui": "npx playwright test --config=e2e/playwright.config.ts --ui",
    "test:ci": "cross-env APP_ENV=test next build && npx playwright test --config=e2e/playwright.config.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:visual": ".storybook/visual-regression/run.sh"
  },
  "dependencies": {
    "@axa-fr/react-oidc": "^7.29.8",
    "@dagrejs/dagre": "^1.1.8",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-table": "^8.21.3",
    "@types/crypto-js": "^4.2.2",
    "@types/d3": "^7.4.3",
    "@types/lodash": "4.17.24",
    "@types/node": "20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-window": "^1.8.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.12.0",
    "chart.js": "^4.6.1",
    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.23",
    "elkjs": "^0.10.2",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "framer-motion": "^12.43.0",
    "ip-address": "^10.7.5",
    "js-cookie": "^3.0.8",
    "lodash": "4.18.1",
    "lucide-react": "^0.566.0",
    "next": "16.4.3",
    "punycode": "^2.3.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-ga4": "^2.1.0",
    "react-hotjar": "^6.3.1",
    "react-hotkeys-hook": "^4.6.2",
    "react-icons": "^5.7.0",
    "react-jwt": "^1.3.0",
    "react-loading-skeleton": "^3.5.0",
    "react-responsive": "^9.0.2",
    "react-virtuoso": "^4.18.19",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "timescape": "^0.7.1",
    "typescript": "^5.9.3"
