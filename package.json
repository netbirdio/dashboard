    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chroma-js": "^3.1.3",
    "@types/js-cookie": "^3.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "prettier": "3.0.3",
    "reg-cli": "^0.19.0-rc3",
    "storybook": "^10.6.4",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@axa-fr/oidc-client": false,
    "@axa-fr/react-oidc": false,
    "esbuild": false,
    "fsevents": false,
    "unrs-resolver": false
  }
}
